<!--
    Every colour, font and control style lives here rather than being repeated inline on each
    element. In the two original projects the header bar, fonts and field styling were copied
    literally between MainWindow.xaml files, and they had already drifted apart - the Lite
    window was 790 wide with a 775 wide header, leaving a visible gap down the right hand side
    that the full build did not have. One dictionary makes that class of drift impossible.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ==== Palette ======================================================== -->

    <SolidColorBrush x:Key="AccentBrush" Color="DarkSlateBlue" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="White" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF6F6F8" />
    <SolidColorBrush x:Key="PanelBrush" Color="White" />
    <SolidColorBrush x:Key="BorderBrushColor" Color="#FFC8C8D0" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF1A1A1E" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF5A5A66" />
    <SolidColorBrush x:Key="AlertBrush" Color="#FFCC0000" />

    <sys:Double x:Key="BodyFontSize">14</sys:Double>

    <!-- ==== Window chrome ================================================== -->

    <Style x:Key="HeaderBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The build number, so the service desk can tell which version is deployed without
         having to go and look at the file properties. -->
    <Style x:Key="HeaderVersionStyle" TargetType="TextBlock" BasedOn="{StaticResource HeaderTitleStyle}">
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ==== Fields ========================================================= -->

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <!--
        IsReadOnly rather than IsEnabled="False".

        The originals disabled these boxes, which greys the text out AND blocks selection - so
        the one thing a user actually needs to do with a hostname or an error code, copy it and
        read it out to the service desk, was impossible. Read-only keeps full contrast and
        Ctrl+C works.
    -->
    <Style x:Key="ReadOnlyFieldStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="IsReadOnlyCaretVisible" Value="False" />
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="MinHeight" Value="27" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="BannerStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="{StaticResource AlertBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,18,0,18" />
    </Style>

    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- ==== Controls ======================================================= -->

    <Style x:Key="OptionCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="4,7,4,7" />
        <Setter Property="Padding" Value="6,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

</ResourceDictionary>
